+local function get_cpu_temperature()
+  local temp_file = io.open("/sys/class/thermal/thermal_zone0/temp", "r")
+  if temp_file then
+    local temp = temp_file:read("*n")
+    temp_file:close()
+    if temp then
+      return math.floor(temp / 1000)
+    end
+  end
+  return 0
 end
 
