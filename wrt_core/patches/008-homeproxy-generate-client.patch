+			push_node_outbound(client_config, node, 'cfg-' + target + '-out');
+			push(routing_nodes, target);
+		}
+	} else if (!(routing_node in ['urltest', 'selector'])) {
+		push_routing_target_outbound(client_config, routing_node, routing_nodes);
+	} else {
+		return;
+	}
