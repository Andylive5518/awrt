#!/bin/sh
# 为 luci-app-adguardhome 补充 UCI 认证配置、修正 config 路径、创建运行时用户
# luci 读取的字段名因版本而异（username 或 web_username），两侧都设
# 位置排在 994，在 AdGuardHome 包自带的 uci-defaults 之后执行
#
# 注意：包默认 config 路径是 /etc/adguardhome.yaml，会触发 init 脚本拒绝：
#   "AdGuard Home config must be stored in its own directory, and not in /etc"
# 修正为 /etc/adguardhome/adguardhome.yaml
#
# 2026-05-30：新增 adguardhome 用户/组/procd jail capabilities 创建
# 包自身在某些情况下不会创建这些，导致 init 脚本 crash loop

[ -f /etc/config/adguardhome ] || exit 0

# --- 创建 adguardhome 用户和组 ---
grep -q '^adguardhome:' /etc/passwd || \
    echo 'adguardhome:*:1000:1000:adguardhome:/var/lib/adguardhome:/bin/false' >> /etc/passwd
grep -q '^adguardhome:' /etc/group || \
    echo 'adguardhome:x:1000:' >> /etc/group

# --- 创建 procd jail capabilities ---
mkdir -p /etc/capabilities
[ -f /etc/capabilities/adguardhome.json ] || cat > /etc/capabilities/adguardhome.json << 'CAPEOF'
{
  "bounding": ["CAP_NET_BIND_SERVICE", "CAP_NET_RAW"],
  "effective": ["CAP_NET_BIND_SERVICE", "CAP_NET_RAW"],
  "permitted": ["CAP_NET_BIND_SERVICE", "CAP_NET_RAW"],
  "inheritable": []
}
CAPEOF

# --- 确保工作目录存在 ---
# AdGuardHome 二进制编译时硬编码了 /tmp/lib/adguardhome 路径
mkdir -p /tmp/lib/adguardhome /var/lib/adguardhome
chown -R adguardhome:adguardhome /tmp/lib/adguardhome /var/lib/adguardhome 2>/dev/null

# --- 修正 config 路径（包默认 /etc/adguardhome.yaml 会导致启动失败）---
current_config=$(uci -q get adguardhome.config.config 2>/dev/null)
if [ "$current_config" = "/etc/adguardhome.yaml" ] || [ -z "$current_config" ]; then
    uci -q set adguardhome.config.config='/etc/adguardhome/adguardhome.yaml'
fi

for field in web_username web_password username password; do
    if ! uci -q get "adguardhome.config.${field}" >/dev/null 2>&1; then
        uci -q set "adguardhome.config.${field}=admin"
    fi
done

uci commit adguardhome
exit 0
