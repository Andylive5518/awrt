+function parseController(value) {
+	let result = {
+		hostname: '',
+		port: '',
+		https: false
+	};
+
+	if (!value)
+		return result;
+
+	try {
+		let url = new URL(value.match(/^https?:\/\//) ? value : 'http://' + value);
+		result.hostname = url.hostname;
+		result.port = url.port;
+		result.https = url.protocol === 'https:';
+	} catch(e) { }
+
+	return result;
+}
