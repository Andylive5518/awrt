#!/bin/sh
# 为 PBR 添加移动/电信/联通策略路由配置文件引用
# pbr.user.* 文件已在固件中，此脚本在首次启动时将它们注册到 /etc/config/pbr

PBR_CONF="/etc/config/pbr"
[ -f "$PBR_CONF" ] || exit 0

add_pbr_include() {
    isp="$1"
    # 检查是否已存在任一配置（IPv4 或 IPv6）
    if ! uci show pbr 2>/dev/null | grep -Fq "pbr.user.${isp}"; then
        uci add pbr include >/dev/null
        uci set "pbr.@include[-1].path=/usr/share/pbr/pbr.user.${isp}"
        uci set "pbr.@include[-1].enabled=0"
        uci add pbr include >/dev/null
        uci set "pbr.@include[-1].path=/usr/share/pbr/pbr.user.${isp}6"
        uci set "pbr.@include[-1].enabled=0"
    fi
}

add_pbr_include "cmcc"
add_pbr_include "ctcc"
add_pbr_include "cucc"

# 提交所有更改
if uci changes pbr | grep -q .; then
    uci commit pbr
fi

exit 0
