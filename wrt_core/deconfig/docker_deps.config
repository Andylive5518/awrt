# Docker Stack Dependencies for nftables Backend
# This file contains dependencies required for Docker v29.3.x with nftables default

# Core docker dependencies
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-blake2b=y
CONFIG_PACKAGE_kmod-crypto-xxhash=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-raid6=y
CONFIG_PACKAGE_kmod-lib-xor=y
CONFIG_PACKAGE_kmod-lib-xxhash=y
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-br-netfilter=y

# Keep these iptables-related modules for current dockerd package DEPENDS.
# They are compatibility/runtime requirements in upstream OpenWrt dockerd Makefile.
# NOTE: Removed kmod-ipt-nat/nat6/physdev — on kernel 6.18+, legacy iptables
# kernel modules (ip_tables.ko etc.) are absent. Docker with nftables backend
# uses kmod-nft-nat (already below) + kmod-br-netfilter for bridge.
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y

# nftables backend support
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-netdev=y

# iptables-nft compatibility layer (for coexistence)
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# Docker bridge networking requires legacy iptables MASQUERADE target
# kmod-nft-nat 提供 nftables 层 NAT，但 Docker daemon 仍用 iptables -j MASQUERADE
# Docker 还需要 addrtype match：kmod-ipt-extra (内核模块) + iptables-mod-extra (用户态 .so)
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_iptables-mod-extra=y

# Docker cgroup 支持（消除 daemon 启动时的 cgroup 警告）
# 内存限制
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_SWAP=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y
# CPU 限制
CONFIG_KERNEL_CGROUP_SCHED=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CFS_BANDWIDTH=y
# IO 限制
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_BLK_DEV_THROTTLING=y
# 其他 cgroup 子系统（可能已默认开启，显式声明确保不被遗漏）
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_PERF=y
